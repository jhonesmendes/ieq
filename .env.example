# Exemplo de variáveis de ambiente para usar MariaDB/MySQL
# Defina DB_DRIVER como 'mysql' para usar MariaDB (padrão é sqlite)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jhones_09_ieq
DB_USER=root
DB_PASS=

# Em Windows/XAMPP: adicione essas variáveis ao Apache (httpd.conf) ou use um gerenciador de ambiente
# Alternativamente, use um pacote como phpdotenv ou defina $_ENV antes de incluir os arquivos de configuração.

