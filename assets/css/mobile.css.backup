/* ========================================
   MOBILE.CSS - Estilos Específicos para Mobile
   Aplicado após todos os outros CSS
   ======================================== */

/* Breakpoint Mobile: Até 768px */
@media (max-width: 768px) {
    
    /* ======== CONTAINER & LAYOUT ======== */
    
    * {
        max-width: 100vw;
        overflow-x: hidden;
    }
    
    body {
        margin: 0;
        padding: 0;
        font-size: 14px;
        line-height: 1.4;
    }

    .container-main {
        flex-direction: column;
        width: 100%;
        min-height: 100vh;
    }

    .main-content {
        padding: 0.75rem 0.5rem;
        padding-top: 3rem;
        width: 100%;
        background-size: 100%;
    }

    /* ======== PAGE HEADER ======== */
    
    .page-header {
        flex-direction: column;
        align-items: stretch;
        gap: 0.75rem;
        margin-bottom: 1rem;
        padding: 0.75rem 0;
    }

    .page-header h1 {
        font-size: 1.25rem;
        margin: 0;
        line-height: 1.3;
        word-break: break-word;
    }

    .page-header p {
        font-size: 0.8rem;
        margin: 0;
        color: #666;
        word-break: break-word;
    }

    .page-header button {
        width: 100%;
        min-height: 44px;
    }

    /* ======== CARDS ======== */
    
    .card {
        padding: 0.75rem;
        margin-bottom: 0.75rem;
        border-radius: 8px;
        overflow: hidden;
    }

    .card h2 {
        font-size: 1.1rem;
        margin: 0 0 0.75rem 0;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #e0e0e0;
    }

    .card h3 {
        font-size: 0.95rem;
        margin: 0.5rem 0;
    }

    .card p {
        font-size: 0.85rem;
        margin: 0.25rem 0;
        line-height: 1.4;
    }

    /* ======== BUTTONS ======== */
    
    /* Sidebar Toggle Button - Menu Hamburger */
    .sidebar-toggle {
        display: flex !important;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: 2px solid #667eea;
        border-radius: 8px;
        color: white;
        font-size: 1.5rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        position: fixed;
        top: 1rem;
        left: 1rem;
        z-index: 101;
    }

    .sidebar-toggle:hover {
        background: linear-gradient(135deg, #5568d3 0%, #6b3a8f 100%);
        box-shadow: 0 6px 16px rgba(102, 126, 234, 0.6);
        transform: scale(1.05);
    }

    .sidebar-toggle:active {
        transform: scale(0.95);
    }
    
    .btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 44px;
        padding: 10px 12px;
        font-size: 0.9rem;
        border-radius: 6px;
        gap: 6px;
        white-space: normal;
        text-align: center;
        margin-bottom: 8px;
    }

    .btn:last-child {
        margin-bottom: 0;
    }

    .btn-small {
        width: 100%;
        min-height: 40px;
        padding: 8px 10px;
        font-size: 0.8rem;
        margin-bottom: 6px;
    }

    .btn-primary,
    .btn-secondary,
    .btn-success,
    .btn-info,
    .btn-danger {
        width: 100%;
    }

    /* ======== FILTERS & FORMS ======== */
    
    .presenca-filters,
    .relatorio-filters,
    .relatorio-header,
    .filtros {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 10px;
        margin-bottom: 15px;
    }

    .form-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .form-item label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #333;
    }

    .form-item input,
    .form-item select,
    .form-item textarea {
        width: 100%;
        min-height: 44px;
        padding: 10px 8px;
        font-size: 1rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        word-break: break-word;
    }

    .form-row {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-row .form-item {
        width: 100%;
    }

    /* ======== TABLES ======== */
    
    /* Converter tabelas em card view em mobile */
    .data-table,
    .presenca-table,
    .visitantes-table,
    .usuarios-table {
        display: block;
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border-collapse: collapse;
    }

    .data-table thead,
    .presenca-table thead,
    .visitantes-table thead,
    .usuarios-table thead {
        display: block;
        width: 100%;
    }

    .data-table tbody,
    .presenca-table tbody,
    .visitantes-table tbody,
    .usuarios-table tbody {
        display: block;
        width: 100%;
    }

    /* Headers da tabela */
    .data-table th,
    .presenca-table th,
    .visitantes-table th,
    .usuarios-table th {
        padding: 10px 8px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-align: left;
        word-wrap: break-word;
        word-break: break-word;
        white-space: normal;
        min-height: 45px;
        vertical-align: middle;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        color: white !important;
    }

    /* Linhas da tabela */
    .data-table tbody tr,
    .presenca-table tbody tr,
    .visitantes-table tbody tr,
    .usuarios-table tbody tr {
        display: block;
        width: 100%;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        margin-bottom: 8px;
        padding: 8px 0;
        background: white;
    }

    /* Células da tabela */
    .data-table td,
    .presenca-table td,
    .visitantes-table td,
    .usuarios-table td {
        display: block;
        width: 100%;
        padding: 10px 8px;
        font-size: 0.8rem;
        word-wrap: break-word;
        word-break: break-word;
        white-space: normal;
        min-height: 40px;
        border-bottom: 1px solid #f5f5f5;
        text-align: left;
    }

    .data-table td:before,
    .presenca-table td:before,
    .visitantes-table td:before,
    .usuarios-table td:before {
        content: attr(data-label);
        font-weight: 700;
        display: block;
        font-size: 0.75rem;
        color: #667eea;
        margin-bottom: 4px;
        text-transform: uppercase;
    }

    .data-table td:last-child,
    .presenca-table td:last-child,
    .visitantes-table td:last-child,
    .usuarios-table td:last-child {
        border-bottom: none;
    }

    /* Checkboxes em tabelas */
    .data-table input[type="checkbox"],
    .presenca-table input[type="checkbox"] {
        width: 20px;
        height: 20px;
        cursor: pointer;
        margin: 8px 0;
    }

    /* Botões em tabelas */
    .data-table .btn-small,
    .data-table button,
    .presenca-table button,
    .usuarios-table button,
    .visitantes-table button {
        display: block;
        width: 100%;
        min-height: 40px;
        padding: 8px 10px;
        font-size: 0.75rem;
        margin: 4px 0;
        border-radius: 4px;
        cursor: pointer;
        word-break: break-word;
    }

    /* ======== BADGES & STATUS ======== */
    
    .badge {
        display: inline-block;
        padding: 6px 10px;
        font-size: 0.7rem;
        font-weight: 600;
        border-radius: 4px;
        text-transform: uppercase;
        margin: 2px 2px 2px 0;
        word-break: break-word;
    }

    .status-badge {
        display: block;
        padding: 8px 10px;
        font-size: 0.8rem;
        margin: 4px 0;
        border-radius: 4px;
        font-weight: 600;
    }

    /* ======== GRIDS ======== */
    
    .stats-grid,
    .relatorio-grid,
    .visitantes-grid,
    .usuarios-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .stats-card,
    .relatorio-card,
    .stat-card {
        padding: 12px;
        border-radius: 8px;
        min-height: auto;
    }

    .stats-icon,
    .stat-icon {
        font-size: 28px;
        margin-bottom: 8px;
    }

    .stats-value,
    .stat-value {
        font-size: 1.5rem;
        font-weight: 700;
    }

    .stats-label,
    .stat-label {
        font-size: 0.8rem;
        color: #666;
    }

    /* ======== MODALS ======== */
    
    .modal-content {
        width: 95% !important;
        max-width: 95vw !important;
        max-height: 90vh !important;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        padding: 12px !important;
    }

    .modal-header {
        padding: 12px;
        margin-bottom: 12px;
    }

    .modal-header h2,
    .modal-header h3 {
        font-size: 1.1rem;
        margin: 0;
        word-break: break-word;
    }

    .modal-close {
        font-size: 24px;
        width: 32px;
        height: 32px;
        padding: 0;
    }

    .modal-body {
        padding: 0;
    }

    .modal-footer {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 12px 0;
        margin-top: 12px;
        border-top: 1px solid #e0e0e0;
    }

    .modal-footer button {
        width: 100%;
        min-height: 44px;
    }

    /* ======== SEARCH & FILTERS ======== */
    
    .search-box,
    .search-input {
        width: 100%;
        min-height: 44px;
        padding: 10px 12px;
        font-size: 1rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        margin-bottom: 12px;
    }

    .filter-select {
        width: 100%;
        min-height: 44px;
        padding: 10px 12px;
        font-size: 0.95rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        margin-bottom: 8px;
    }

    /* ======== LEGENDS & LABELS ======== */
    
    .legenda-presenca {
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-start;
        margin: 12px 0;
    }

    .legenda-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
    }

    .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    /* ======== ACCORDIONS & COLLAPSIBLES ======== */
    
    .accordion {
        margin-bottom: 12px;
    }

    .accordion-header {
        background: #f5f5f5;
        padding: 12px;
        border-radius: 6px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 600;
        user-select: none;
    }

    .accordion-content {
        padding: 12px;
        background: white;
        border: 1px solid #e0e0e0;
        border-top: none;
        border-radius: 0 0 6px 6px;
    }

    /* ======== ALERTS ======== */
    
    .alert {
        padding: 12px;
        margin-bottom: 12px;
        border-radius: 6px;
        font-size: 0.9rem;
        word-break: break-word;
        border-left: 4px solid;
    }

    .alert-success {
        border-left-color: #28a745;
    }

    .alert-danger {
        border-left-color: #dc3545;
    }

    .alert-warning {
        border-left-color: #ffc107;
    }

    .alert-info {
        border-left-color: #17a2b8;
    }

    /* ======== TYPOGRAPHY ======== */
    
    h1 {
        font-size: 1.25rem;
        line-height: 1.3;
        word-break: break-word;
    }

    h2 {
        font-size: 1.1rem;
        line-height: 1.3;
        word-break: break-word;
    }

    h3 {
        font-size: 1rem;
        line-height: 1.3;
        word-break: break-word;
    }

    h4,
    h5,
    h6 {
        font-size: 0.95rem;
        line-height: 1.3;
        word-break: break-word;
    }

    p {
        font-size: 0.85rem;
        line-height: 1.4;
        word-break: break-word;
        margin: 0.5rem 0;
    }

    strong,
    b {
        font-weight: 700;
    }

    small {
        font-size: 0.75rem;
    }

    /* ======== PADDING & MARGINS ======== */
    
    .mb-1 { margin-bottom: 0.5rem; }
    .mb-2 { margin-bottom: 1rem; }
    .mb-3 { margin-bottom: 1.5rem; }
    
    .mt-1 { margin-top: 0.5rem; }
    .mt-2 { margin-top: 1rem; }
    .mt-3 { margin-top: 1.5rem; }
    
    .p-1 { padding: 0.5rem; }
    .p-2 { padding: 1rem; }
    .p-3 { padding: 1.5rem; }

    /* ======== DASHBOARD MOBILE ======== */
    
    /* Ocultar seção de Membros Recentes em mobile */
    .dashboard-section:has(#membros-recentes),
    #membros-recentes {
        display: none !important;
        visibility: hidden;
        height: 0;
        overflow: hidden;
    }

    /* Eventos em Mobile */
    .events-section {
        grid-column: auto !important;
        width: 100%;
        margin-top: 1rem;
    }

    .events-list {
        display: flex !important;
        flex-direction: column;
        gap: 12px;
        perspective: none;
    }

    .event-item {
        padding: 12px;
        border-radius: 8px;
        border-left: 4px solid #f39c12;
        background: linear-gradient(135deg, #fff8f0 0%, #fff4e6 100%);
        box-shadow: 0 2px 6px rgba(243, 156, 18, 0.1);
        transform: none !important;
        transition: background-color 0.3s ease;
    }

    .event-item:hover {
        transform: none !important;
        background: linear-gradient(135deg, #fff6e6 0%, #fff0d4 100%);
        box-shadow: 0 4px 10px rgba(243, 156, 18, 0.2);
    }

    .event-date {
        display: inline-block;
        padding: 4px 8px;
        background: #f39c12;
        color: white;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .event-info {
        width: 100%;
    }

    .event-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 6px;
        word-break: break-word;
    }

    .event-details {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .event-time,
    .event-location,
    .event-description {
        font-size: 0.8rem;
        color: #666;
        word-break: break-word;
    }

    /* ======== UTILITÁRIOS ======== */
    
    .hidden-mobile {
        display: none !important;
    }

    .full-width {
        width: 100%;
    }

    .text-center {
        text-align: center;
    }

    .text-left {
        text-align: left;
    }

    .text-right {
        text-align: right;
    }

    .no-wrap {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .break-word {
        word-break: break-word;
        word-wrap: break-word;
        white-space: normal;
    }

    /* ======== CLEARFIX ======== */
    
    .clearfix::after {
        content: "";
        display: table;
        clear: both;
    }

    /* ======== SAFE ZONE (Notches) ======== */
    
    @supports (padding: max(0px)) {
        body {
            padding-left: max(12px, env(safe-area-inset-left));
            padding-right: max(12px, env(safe-area-inset-right));
            padding-top: max(12px, env(safe-area-inset-top));
            padding-bottom: max(12px, env(safe-area-inset-bottom));
        }
    }

    /* ======== ORIENTATION ======== */
    
    @media (max-width: 768px) and (orientation: landscape) {
        .main-content {
            padding-top: 3rem;
            padding-bottom: 1rem;
        }

        .modal-content {
            max-height: 85vh;
        }

        h1 {
            font-size: 1.1rem;
        }
    }
}

/* ========================================
   EXTRA SMALL DEVICES (< 480px)
   ======================================== */

@media (max-width: 480px) {
    
    .main-content {
        padding: 0.5rem;
        padding-top: 2.5rem;
    }

    .page-header {
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .page-header h1 {
        font-size: 1.1rem;
    }

    .page-header p {
        font-size: 0.75rem;
    }

    .card {
        padding: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .btn,
    .btn-small {
        font-size: 0.85rem;
        padding: 8px 10px;
    }

    .form-item input,
    .form-item select,
    .form-item textarea {
        font-size: 16px; /* Previne zoom em iOS */
        min-height: 44px;
    }

    .data-table th {
        font-size: 0.65rem;
        padding: 8px 6px;
    }

    .data-table td {
        font-size: 0.75rem;
        padding: 8px 6px;
    }

    .badge {
        font-size: 0.65rem;
        padding: 4px 8px;
    }

    h1 { font-size: 1.1rem; }
    h2 { font-size: 1rem; }
    h3 { font-size: 0.9rem; }
    p { font-size: 0.8rem; }

    .modal-content {
        width: 98% !important;
        max-width: 98vw !important;
    }
}

/* ========================================
   SMALL DEVICES (480px - 600px)
   ======================================== */

@media (min-width: 481px) and (max-width: 600px) {
    
    .main-content {
        padding: 0.75rem;
        padding-top: 3rem;
    }

    .btn,
    .btn-small {
        font-size: 0.87rem;
        padding: 9px 11px;
    }

    h1 { font-size: 1.2rem; }
    h2 { font-size: 1.05rem; }
    p { font-size: 0.82rem; }
}

/* ========================================
   MEDIUM DEVICES (600px - 768px)
   ======================================== */

@media (min-width: 601px) and (max-width: 768px) {
    
    .main-content {
        padding: 1rem;
        padding-top: 3.5rem;
    }

    .stats-grid,
    .relatorio-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .data-table th {
        font-size: 0.75rem;
    }

    .data-table td {
        font-size: 0.85rem;
    }

    h1 { font-size: 1.3rem; }
    h2 { font-size: 1.1rem; }
    p { font-size: 0.87rem; }
}

/* ========================================
   PRINT STYLES
   ======================================== */

@media print {
    .sidebar,
    .modal-overlay,
    .btn-print {
        display: none !important;
    }

    .main-content {
        padding: 0;
    }

    body {
        background: white;
    }
}
